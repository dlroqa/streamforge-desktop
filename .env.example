VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional: backend that turns YouTube/other links into a video file for the
# editor's "Video Cut" tool. Deploy ./video-cut-resolver and put its URL here.
# Direct .mp4/.webm URLs work without this. Defaults to same-origin /video-cut.
VITE_VIDEO_CUT_ENDPOINT="https://your-resolver.onrender.com"

# Optional: HyperFrames render service powering Motion Graphics (Studio panel
# + editor toolbar). Run `npm start` in ./hyperframes-service. Defaults to
# /hyperframes, which the dev server proxies to localhost:8791 — only set this
# to point at a remotely hosted service.
# VITE_HYPERFRAMES_ENDPOINT="https://your-hyperframes.example.com"
